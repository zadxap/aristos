{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Основное окно: ядро + нативные уведомления (напоминания о парах и дедлайнах).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "process:default",
    "opener:default",
    "allow-write-widget-data",
    "allow-sync-open",
    "allow-sync-eval",
    "allow-sync-url",
    "allow-sync-diag",
    "allow-sync-close",
    "allow-canvas-session-state",
    "allow-canvas-sync-native",
    "allow-download-update",
    "allow-install-apk",
    "allow-sync-read-log",
    "allow-sync-upload-diag"
  ]
}
