{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aristos",
  "version": "0.1.0",
  "identifier": "kz.yessenov.aristos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aristos",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Студенттік дашборд — кесте, бағалар, дедлайндер",
    "longDescription": "Yessenov University студенттеріне арналған оффлайн дашборд: сабақ кестесі, Canvas тапсырмалары, Платонус бағалары, GPA калькуляторы.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
