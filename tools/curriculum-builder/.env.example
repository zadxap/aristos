# Скопируйте файл в .env.local и при необходимости заполните значения.
# Значения из env используются, только если соответствующее поле не задано
# в панели «AI-ассистент» (пользовательские настройки хранятся в localStorage).

# VITE_AI_BASE_URL=https://api.openai.com/v1
# VITE_AI_API_KEY=sk-...
# VITE_AI_MODEL=gpt-4o-mini
